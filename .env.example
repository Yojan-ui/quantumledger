# AetherPool stack (engine/, backend/, frontend/, scripts/). Every variable is optional: the defaults
# below are what the code uses when it's unset. Load into your shell with:  set -a; . ./.env; set +a
# (The QuantumLedger web app has its own file: q-setu/apps/web/.env.example.)

# ── Engine build ───────────────────────────────────────────────────────────────────────────
# OpenSSL 3 for the classical ECDSA/RSA/ECDH baseline. Unset = macOS Security.framework (slower EC
# numbers, labelled in the UI). Homebrew: OPENSSL_ROOT_DIR="$(brew --prefix openssl@3)"
# OPENSSL_ROOT_DIR=/opt/homebrew/opt/openssl@3

# ── Backend (FastAPI bridge) ───────────────────────────────────────────────────────────────
# Where the C++ engine listens (backend/engine_client.py).
AETHER_ENGINE_HOST=127.0.0.1
AETHER_ENGINE_PORT=9001
# Path to the engine's C ABI library (backend/aether/pqc_native.py).
# Default: engine/build/libaetherpqc.dylib on macOS, engine/build/libaetherpqc.so on Linux.
# AETHER_PQC_LIB=/absolute/path/to/libaetherpqc.dylib
