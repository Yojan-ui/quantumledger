# ── Site ──────────────────────────────────────────────────────────────────────────────────
# Canonical URL (metadata, sitemap, share links, OG images). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Q-Shield pipeline (Atlas backend) ─────────────────────────────────────────────────────────
# Where the /atlas-api/* route handler forwards to: the Atlas server from ../qshield (pnpm dev:atlas).
# Port 8100, because AetherPool's backend owns 8000.
ATLAS_URL=http://127.0.0.1:8100

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Postgres in production (Neon, Supabase, Railway...). Leave unset to use SQLite in QSETU_DATA_DIR.
# DATABASE_URL=postgres://user:password@host:5432/qsetu
# Where the SQLite file (and, without QSETU_KMS_KEK, the demo KEK) live. Default: apps/web/.data
# QSETU_DATA_DIR=/data

# ── Keys ──────────────────────────────────────────────────────────────────────────────────
# 32-byte key-encryption key (64 hex chars) that wraps every KMS key. REQUIRED in production:
# without it a KEK file is created in QSETU_DATA_DIR, which an ephemeral container would lose.
# Generate: openssl rand -hex 32
# QSETU_KMS_KEK=
# Scheduled key rotation interval in milliseconds (default 600000 = 10 minutes).
# QSETU_ROTATE_MS=600000
# Seed for the Web shield demo keys (otherwise a public demo seed is used).
# QSETU_WEB_SHIELD_SEED=

# ── Offline demo mode ─────────────────────────────────────────────────────────────────────
# 1 = no outbound network: URL scans answer from pre-cached real scans, GeoIP is skipped.
# NEXT_PUBLIC_OFFLINE=0

# ── Admin and email ───────────────────────────────────────────────────────────────────────
# Password for /admin (signups list + CSV export). 12+ characters; unset = admin disabled.
# ADMIN_PASSWORD=
# Resend API key for early-access confirmation emails (optional) and the From address.
# RESEND_API_KEY=
# RESEND_FROM="QuantumLedger <hello@your-domain.in>"

# ── Security and analytics ────────────────────────────────────────────────────────────────
# Contact published in /.well-known/security.txt (mailto: or https: URL).
# SECURITY_CONTACT=mailto:security@your-domain.in
# Plausible (privacy-friendly analytics). Unset = no analytics script at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.in
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
