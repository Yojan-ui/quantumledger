# ── Site ──────────────────────────────────────────────────────────────────────────────────
# Canonical URL (metadata, sitemap, share links, OG images). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Postgres in production (Neon, Supabase, Railway...). Leave unset to use SQLite in QSETU_DATA_DIR.
# DATABASE_URL=postgres://user:password@host:5432/qsetu
# Where the SQLite file (and, without QSETU_KMS_KEK, the demo KEK) live. Default: apps/web/.data
# QSETU_DATA_DIR=/data

# ── Keys ──────────────────────────────────────────────────────────────────────────────────
# 32-byte key-encryption key (64 hex chars) that wraps every KMS key. REQUIRED in production:
# without it a KEK file is created in QSETU_DATA_DIR, which an ephemeral container would lose.
# Generate: openssl rand -hex 32
# QSETU_KMS_KEK=
# Scheduled key rotation interval in milliseconds (default 600000 = 10 minutes).
# QSETU_ROTATE_MS=600000
# Seed for the Web shield demo keys (otherwise a public demo seed is used).
# QSETU_WEB_SHIELD_SEED=

# ── Offline demo mode ─────────────────────────────────────────────────────────────────────
# 1 = no outbound network: URL scans answer from pre-cached real scans, GeoIP is skipped.
# NEXT_PUBLIC_OFFLINE=0

# ── Admin and email ───────────────────────────────────────────────────────────────────────
# Password for /admin (signups list + CSV export). 12+ characters; unset = admin disabled.
# ADMIN_PASSWORD=
# Admin second factor (TOTP, base32). Required in production: without it admin stays off.
# Make one with `node scripts/admin-totp.mjs`.
# ADMIN_TOTP_SECRET=
# Security alerts (admin sign-in bursts, Shield canary hits) are POSTed here as JSON (https only).
# ALERT_WEBHOOK_URL=
# Resend API key for early-access confirmation emails (optional) and the From address.
# RESEND_API_KEY=
# RESEND_FROM="QuantumLedger <hello@your-domain.in>"

# ── Security and analytics ────────────────────────────────────────────────────────────────
# Contact published in /.well-known/security.txt (mailto: or https: URL).
# SECURITY_CONTACT=mailto:security@your-domain.in
# Plausible (privacy-friendly analytics). Unset = no analytics script at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.in
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# ── Security hardening ────────────────────────────────────────────────────────────────────
# How many proxies sit in front of the app and append to X-Forwarded-For (Vercel/Render: 1). The
# client IP is the entry that many hops from the right; the client-written left entries are ignored.
# TRUSTED_PROXY_HOPS=1
# Signs the anonymous demo session cookie (32+ random bytes). REQUIRED in production:
# openssl rand -base64 32
# SESSION_SECRET=
# Shared rate limits across instances (Upstash Redis REST). Use a database dedicated to rate
# limiting; the token only needs INCR/PEXPIRE on it. Unset = in-process limits.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Salt for the IP hashes in logs. Rotate it to unlink old logs from new ones.
# LOG_SALT=
# Abuse alerts (repeated rate-limit hits, error spikes): a Slack/Discord/generic webhook URL.
# ALERT_WEBHOOK_URL=
# Cloudflare Turnstile for the URL scanner (bot protection). Unset = Turnstile off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Shield dashboard (/app) ────────────────────────────────────────────────────────────────
# Signs dashboard sessions and seals TOTP secrets (≥ 32 random characters). Falls back to
# SESSION_SECRET; without either, a random per-process key (everyone is signed out on restart).
# DASHBOARD_SECRET=

