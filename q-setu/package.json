{
  "name": "quantumledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,legacy,shield-srv,shield-cli -c cyan,gray,yellow,magenta \"pnpm --filter @qsetu/web dev\" \"pnpm --filter @qsetu/legacy-bank dev\" \"pnpm dev:shield-server\" \"pnpm dev:shield-client\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @qsetu/web start",
    "demo": "pnpm --filter @qsetu/web build && concurrently -k -n web,lab -c cyan,magenta \"LAB_DEMO_ACCOUNTS=team@quantumledger.dev=team,ciso@ledgerwood.example=customer:ledgerwood,it@sahyadri.example=customer:sahyadri pnpm --filter @qsetu/web start\" \"ATTACK_LAB_SEED=1 pnpm --filter @qsetu/attack-lab dev\"",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @qsetu/web lint && pnpm lint:design && prettier --check .",
    "format": "prettier --write .",
    "dev:shield-server": "tsx packages/shield-proxy/src/cli.ts --upstream http://127.0.0.1:4000 --listen 8443 --demo-identity",
    "dev:shield-client": "tsx packages/shield-proxy/src/cli.ts --peer http://127.0.0.1:8443 --listen 8080 --demo-identity",
    "dev:web": "pnpm --filter @qsetu/web dev",
    "test:e2e": "playwright test",
    "lint:design": "node scripts/lint-design.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lhci": "lhci autorun",
    "test:e2e:offline": "E2E_OFFLINE=1 playwright test",
    "record:demo": "node scripts/record-demo.mjs",
    "index:build": "pnpm --filter @qsetu/web exec tsx scripts/build-index.mts",
    "judge:tour": "node scripts/judge-tour.mjs",
    "audit:glitch": "tsx scripts/glitch-audit.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "ffmpeg-static": "5.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
