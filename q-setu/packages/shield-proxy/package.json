{
  "name": "@qsetu/shield-proxy",
  "version": "0.1.0",
  "description": "Zero-code-change sidecar: two Shield nodes talk hybrid PQC; the upstream app is untouched.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@qsetu/core": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@qsetu/sdk": "workspace:*",
    "fastify": "^5.12.5"
  },
  "bin": {
    "qsetu-shield": "./dist/cli.js"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
